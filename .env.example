# Copie para .env para rodar localmente. Em producao, cadastre estas variaveis no Render
# (Dashboard > servico > Environment). Nunca suba o .env para o GitHub.

PORT=3000

# --- Banco de dados (OBRIGATORIO em producao) ---
# Postgres gratuito: https://neon.tech (crie um projeto e copie a "connection string").
# Sem DATABASE_URL o servidor usa um banco local em ./data, que no Render e apagado a cada deploy.
DATABASE_URL=

# --- Administrador (OBRIGATORIO) ---
ADMIN_EMAIL=seuemail@exemplo.com
ADMIN_PASSWORD=uma_senha_forte_e_unica
# Chave longa e aleatoria (minimo 32 caracteres). Trocar invalida todas as sessoes.
AUTH_SECRET=gere_uma_chave_aleatoria_longa

# --- Site ---
# Endereco publico do site (usado em links de email e redirecionamentos).
SITE_URL=https://augustonvsilva.github.io/loja-multimarcas
# Origens que podem chamar a API (separadas por virgula). Inclua o dominio proprio se tiver.
ALLOWED_ORIGINS=https://augustonvsilva.github.io

# --- Mercado Pago (OBRIGATORIO para vender) ---
# Painel: https://www.mercadopago.com.br/developers/panel/app > sua aplicacao > Credenciais de producao.
# Chaves TEST-... nao cobram de verdade.
MERCADOPAGO_PUBLIC_KEY=APP_USR-sua_chave_publica
MERCADOPAGO_ACCESS_TOKEN=APP_USR-seu_access_token
# URL do webhook (cadastre a mesma em "Webhooks" no painel, evento "Pagamentos"):
MERCADOPAGO_WEBHOOK_URL=https://loja-multimarcas.onrender.com/api/payments/webhook
# "Assinatura secreta" exibida no painel de Webhooks (valida que a notificacao veio do Mercado Pago).
MERCADOPAGO_WEBHOOK_SECRET=

# --- Emails (opcional, recomendado) ---
# https://resend.com: confirmacao de pedido, aviso de nova venda e recuperacao de senha.
RESEND_API_KEY=
# Remetente verificado no Resend. Sem dominio proprio use: JS Multimarcas <onboarding@resend.dev>
EMAIL_FROM=
# Email da loja que recebe o aviso de cada venda paga.
STORE_NOTIFY_EMAIL=

# --- Correios (opcional) ---
# Sem contrato, o site usa uma tabela de estimativa para PAC e Sedex.
CORREIOS_ORIGIN_CEP=02992130
CORREIOS_ENV=production
CORREIOS_USERNAME=
CORREIOS_API_PASSWORD=
CORREIOS_CARD_NUMBER=
CORREIOS_CONTRACT_NUMBER=
CORREIOS_DR=72
CORREIOS_DEFAULT_WEIGHT_GRAMS=500
CORREIOS_DEFAULT_LENGTH_CM=20
CORREIOS_DEFAULT_WIDTH_CM=20
CORREIOS_DEFAULT_HEIGHT_CM=10
